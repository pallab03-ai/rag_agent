# LLM API Configuration (Choose one)
# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Groq Configuration (Alternative to OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA Configuration (For embeddings - uses OpenAI-compatible API)
# Get API key from: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_MODEL=nvidia/embed-qa-4

# Select LLM Provider (openai or groq)
LLM_PROVIDER=openai

# Select Embedding Provider (openai or nvidia)
EMBEDDING_PROVIDER=openai

# Web Search API Keys (Optional)
TAVILY_API_KEY=your_tavily_api_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# LangSmith Tracing (Optional - for debugging and monitoring)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_key_optional
LANGCHAIN_PROJECT=rag-agent-langgraph

# Agent Configuration
ENABLE_WEB_SEARCH=true
ENABLE_REFLECTION=true
LOG_LEVEL=INFO

# Model Configuration
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.7
MAX_TOKENS=1000

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Web Search Configuration
WEB_SEARCH_PROVIDER=tavily
MAX_SEARCH_RESULTS=5
SEARCH_TIMEOUT=10
